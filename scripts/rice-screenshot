#!/usr/bin/env bash
set -euo pipefail
OUT_DIR="$HOME/Pictures/Screenshots"
mkdir -p "$OUT_DIR"
command -v grim >/dev/null && command -v slurp >/dev/null || { echo "Install grim and slurp" >&2; exit 1; }
file="$OUT_DIR/$(date +%Y-%m-%d_%H-%M-%S).png"
geometry="$(slurp)" || exit 0
[[ -n "$geometry" ]] || exit 0
grim -g "$geometry" "$file"
command -v wl-copy >/dev/null && wl-copy < "$file" || true
command -v notify-send >/dev/null && notify-send "Screenshot saved" "$file" || true
