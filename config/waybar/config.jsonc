{
  "layer":"top","position":"top","height":24,"spacing":4,
  "modules-left":["niri/workspaces","custom/sep","mpris"],"modules-center":[],
  "modules-right":["custom/cpucat","custom/sep","wireplumber","custom/sep","cpu","custom/sep","memory","custom/sep","disk","custom/sep","clock","custom/sep","tray"],
  "niri/workspaces":{"disable-scroll":true,"all-outputs":true,"format":"{name}"},
  "custom/cpucat":{"exec":"printf '󰻠'","interval":5,"tooltip":false},
  "mpris":{"format":" {artist} - {title}","format-paused":"󰐊 {artist} - {title}","max-length":45,"tooltip":true},
  "wireplumber":{"format":"Vol: {volume}%","format-muted":"Muted","on-click":"pavucontrol"},
  "tray":{"spacing":10},"clock":{"format":"{:%H:%M}","format-alt":"{:%Y-%m-%d}"},
  "cpu":{"format":"CPU: {usage}%","tooltip":false},"memory":{"format":"Ram: {used:0.1f}GiB"},
  "disk":{"interval":30,"path":"/","format":"Disk: {free}"},"custom/sep":{"format":"|","interval":"once"}
}
